<Window x:Class="Nightforge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="幻夜工坊"
        Icon="pack://application:,,,/app.ico"
        Height="840" Width="800"
        MinHeight="660" MinWidth="720"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="幻夜工坊" Style="{StaticResource AppTitle}" />
            <TextBlock x:Name="TxtSubtitle" Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="一键多开 · 窗口自动排列 · 全局热键" />

            <Border x:Name="AdminBanner" Visibility="Collapsed" Margin="0,10,0,0"
                    Background="#3A2C12" CornerRadius="6" Padding="12,8">
                <DockPanel>
                    <Button x:Name="BtnRestartAdmin" DockPanel.Dock="Right" Content="以管理员重启"
                            Height="28" MinWidth="118" Click="OnRestartAdminClick" />
                    <TextBlock Foreground="#E8C07A" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="当前不是管理员权限，移动游戏窗口可能失败。" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- 配置区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 游戏设置 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="游戏设置" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏路径" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtGamePath" Height="32" Margin="0,0,8,10"
                                     VerticalContentAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="2" Content="浏览" Width="66" Height="32" Margin="0,0,0,10"
                                    Click="OnBrowseGameClick" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="窗口标题关键词" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtWinTitle" Height="32" Margin="0,0,8,10"
                                     VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="例：梦幻西游" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="启动数量" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbCount" Height="32" Width="120"
                                      HorizontalAlignment="Left" Margin="0,0,8,10" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="启动后等待（秒）" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtWaitSec" Height="32" Width="120"
                                     HorizontalAlignment="Left" Margin="0,0,8,10" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="电脑越慢数值越大" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                                       Text="游戏路径必须包含 .exe 文件名，且文件真实存在。" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 窗口布局 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="窗口布局" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="分辨率模式" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbResMode" Height="32" Width="170"
                                      HorizontalAlignment="Left" Margin="0,0,8,10"
                                      SelectionChanged="OnResModeChanged" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="窗口宽 × 高" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,10">
                                <TextBox x:Name="TxtWinWidth" Height="32" Width="86" VerticalContentAlignment="Center" />
                                <TextBlock Text="×" Margin="10,0" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtWinHeight" Height="32" Width="86" VerticalContentAlignment="Center" />
                                <ComboBox x:Name="CmbResPreset" Height="32" Width="140" Margin="14,0,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                                       Text="5 个窗口走五点布局（左上 / 上中 / 右上 / 左下 / 右下），其余数量自动网格排布。" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 同步器 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="同步器（可选）" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="同步器路径" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="TxtSyncPath" Height="32" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="浏览" Width="66" Height="32" Margin="0,0,8,0" Click="OnBrowseSyncClick" />
                                <Button Content="打开同步器" Height="32" MinWidth="100" Click="OnOpenSyncClick" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="本程序不包含同步器，请自行准备，并可在此填写其完整路径以便一键启动。" />
                    </StackPanel>
                </Border>

                <!-- 热键 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="全局热键" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="前置全部窗口" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtHotkeyFront" Height="32" Margin="0,0,8,10"
                                     VerticalContentAlignment="Center"
                                     ToolTip="可直接输入，如 Ctrl+Alt+T；也可点右侧「设置」按钮按键录制" />
                            <Button Grid.Row="0" Grid.Column="2" Content="设置" Width="66" Height="32" Margin="0,0,0,10"
                                    Tag="Front" Click="OnSetHotkeyClick" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="老板键（最小化）" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtHotkeyMinimize" Height="32" Margin="0,0,8,10"
                                     VerticalContentAlignment="Center"
                                     ToolTip="可直接输入，如 Ctrl+Alt+B；也可点右侧「设置」按钮按键录制" />
                            <Button Grid.Row="1" Grid.Column="2" Content="设置" Width="66" Height="32" Margin="0,0,0,10"
                                    Tag="Minimize" Click="OnSetHotkeyClick" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="获取窗口大小" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtHotkeyGetSize" Height="32" Margin="0,0,8,10"
                                     VerticalContentAlignment="Center"
                                     ToolTip="可直接输入，如 Ctrl+Alt+S；也可点右侧「设置」按钮按键录制" />
                            <Button Grid.Row="2" Grid.Column="2" Content="设置" Width="66" Height="32" Margin="0,0,0,10"
                                    Tag="GetSize" Click="OnSetHotkeyClick" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 日志 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}" Margin="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="清空" Height="26" MinWidth="60" Margin="0,0,8,0" Click="OnClearLogClick" />
                        <Button Content="导出" Height="26" MinWidth="60" Click="OnExportLogClick" />
                    </StackPanel>
                </DockPanel>
                <TextBox x:Name="TxtLog" Height="150" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </StackPanel>
        </Border>

        <!-- 操作按钮 -->
        <WrapPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="一键启动" Style="{StaticResource ActionButton}" MinWidth="120" Click="OnLaunchClick" />
            <Button Content="前置全部" Style="{StaticResource ActionButton}" Click="OnBringAllClick" />
            <Button Content="老板键" Style="{StaticResource ActionButton}" Click="OnBossKeyClick" />
            <Button Content="获取窗口大小" Style="{StaticResource ActionButton}" MinWidth="112" Click="OnGetSizeClick" />
            <Button Content="保存配置" Style="{StaticResource ActionButton}" Click="OnSaveConfigClick" />
            <Button Content="检查更新" Style="{StaticResource ActionButton}" MinWidth="96" Click="OnCheckUpdateClick" />
            <Button Content="更新日志" Style="{StaticResource ActionButton}" MinWidth="96" Click="OnShowChangeLogClick" />
            <Button Content="GitHub 主页" Style="{StaticResource ActionButton}" MinWidth="108" Click="OnOpenRepoClick" />
            <CheckBox x:Name="ChkAutoUpdate" Content="启动时自动检查更新" VerticalAlignment="Center"
                      Margin="6,0,0,10" ToolTip="开启后每次启动会联网查询 GitHub 上的最新版本"
                      Click="OnAutoUpdateChanged" />
            <CheckBox x:Name="ChkAutoDownload" Content="自动下载更新" VerticalAlignment="Center"
                      Margin="10,0,0,10" ToolTip="发现新版本时后台下好整包，重启即换成新版；关闭则只提示下载地址"
                      Click="OnAutoDownloadChanged" />
        </WrapPanel>
    </Grid>
</Window>
