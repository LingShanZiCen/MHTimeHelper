<Window x:Class="Nightforge.AutoLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="自动登录 - 幻夜工坊"
        Height="720" Width="880"
        MinHeight="640" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{StaticResource WindowBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackdrop}"
            BorderBrush="#252C3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="{StaticResource TitleBarBg}">
                <TextBlock Text="自动登录" Style="{StaticResource AppTitle}"
                           FontSize="13.5" Margin="16,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource CaptionCloseButton}"
                        HorizontalAlignment="Right"
                        Click="OnCloseClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="关闭">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>
            </Grid>

            <!-- 主体 -->
            <Grid Grid.Row="1" Margin="20,14,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <CheckBox x:Name="ChkEnabled" Style="{StaticResource OptionCheck}"
                              Content="启用自动登录（一键启动后自动选账号 → 点服务器 → 点角色进去）" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="只填文字，位置不用管：程序把窗口画面截下来认字，在哪找到就点哪。账号可以留空；角色留空则点第一个「点击登录」。建议把服务器名也填上——在「服务器名 + 登录游戏」那一屏，要点服务器名字才会列出角色；不填服务器只填角色，可能直接进上次的角色。填完建议先点「识别测试」，看看这些字能不能认出来。" />
                </StackPanel>

                <!-- 参数 -->
                <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="窗口出现后等" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtStartDelay" Style="{StaticResource InputBox}" Width="58" Height="30"
                             Margin="8,0,6,0" VerticalContentAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="秒" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,18,0" />

                    <TextBlock Text="每步最多等" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtStepTimeout" Style="{StaticResource InputBox}" Width="58" Height="30"
                             Margin="8,0,6,0" VerticalContentAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="秒" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,18,0" />

                    <CheckBox x:Name="ChkAutoClick" Style="{StaticResource OptionCheck}"
                              Content="自动点「登录游戏 / 进入游戏」" VerticalAlignment="Center" />
                </WrapPanel>

                <!-- 填表区 -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 表头 -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="窗口" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="账号（可空）" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="2" Text="服务器" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="3" Text="角色（可空）" Style="{StaticResource FieldLabel}" />
                        </Grid>

                        <!-- 5 行输入框，在代码里生成 -->
                        <Grid x:Name="TargetGrid" Grid.Row="1" VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <!-- 按钮 -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="识别测试" Style="{StaticResource SecondaryButton}"
                                Height="34" MinWidth="96" Click="OnRecognizeClick" />
                        <TextBlock Text="对" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <ComboBox x:Name="CmbTestWindow" Style="{StaticResource Dropdown}"
                                  Width="86" Height="34" />
                        <Button Content="复制窗口 1 到全部" Style="{StaticResource SecondaryButton}"
                                Height="34" MinWidth="132" Margin="12,0,0,0" Click="OnCopyFirstClick" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="保存并关闭" Style="{StaticResource PrimaryButton}"
                                Height="34" MinWidth="104" Click="OnSaveClick" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 状态 / 识别结果 -->
            <Border Grid.Row="2" Background="#11141B" BorderBrush="#1E2430" BorderThickness="0,1,0,0"
                    Padding="20,10">
                <StackPanel>
                    <TextBlock x:Name="TxtStatus" Text="就绪" Foreground="{StaticResource TextSecondary}"
                               FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtOcrResult" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
